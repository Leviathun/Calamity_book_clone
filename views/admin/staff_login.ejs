<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Staff Login — Calamity Books</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/451145afdd.js" crossorigin="anonymous"></script>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1e1e2e 0%, #0f0f15 50%, #1e1e2e 100%);
      padding: 20px;
      position: relative;
      overflow: hidden;
    }
    /* Rich background with crimson/purple mesh gradient overlay */
    body::before {
      content: '';
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(ellipse 800px 600px at 10% 90%, rgba(255, 74, 90, 0.2) 0%, transparent 70%),
        radial-gradient(ellipse 800px 600px at 90% 10%, rgba(139, 92, 246, 0.25) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    body::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 L35 25 L55 30 L35 35 L30 55 L25 35 L5 30 L25 25Z' fill='rgba(255,74,90,0.04)'/%3E%3C/svg%3E");
      background-size: 100px 100px;
      pointer-events: none;
      animation: bgShift 13s linear infinite;
      z-index: 0;
    }
    @keyframes bgShift {
      0% { background-position: 0 0; }
      100% { background-position: 100px 100px; }
    }

    .auth-container {
      display: flex;
      width: 100%;
      max-width: 900px;
      min-height: 560px;
      background: #FFFFFF;
      border-radius: 1.5rem;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,0.4);
      position: relative;
      z-index: 1;
    }

    /* Left panel — branding */
    .auth-brand {
      flex: 1;
      background: linear-gradient(160deg, #ff4a5a 0%, #1e1e2e 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .auth-brand img {
      width: 200px;
      margin-bottom: 2rem;
      filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.4)) drop-shadow(0 0 35px rgba(255, 255, 255, 0.2));
      position: relative;
      z-index: 1;
    }
    .auth-brand h2 {
      color: #FFFFFF;
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
      position: relative; z-index: 1;
      letter-spacing: 1px;
    }
    .auth-brand h2 span {
      color: #ff4a5a;
    }
    .auth-brand p {
      color: rgba(255,255,255,0.75);
      font-size: 0.95rem;
      line-height: 1.6;
      max-width: 260px;
      position: relative; z-index: 1;
    }

    /* Right panel — form */
    .auth-form-panel {
      flex: 1.1;
      padding: 3.5rem 3rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background-color: #ffffff;
    }
    .auth-form-panel h1 {
      font-size: 2rem;
      font-weight: 800;
      color: #1F2937;
      margin-bottom: 0.25rem;
    }
    .auth-form-panel .subtitle {
      color: #6B7280;
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    /* Form fields */
    .form-group {
      margin-bottom: 1.25rem;
    }
    .form-group label {
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      color: #374151;
      margin-bottom: 0.4rem;
    }
    .form-group .input-wrapper {
      position: relative;
    }
    .form-group .input-wrapper i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #9CA3AF;
      font-size: 0.95rem;
      transition: color 0.3s;
    }
    .form-group input {
      width: 100%;
      padding: 0.8rem 1rem 0.8rem 2.8rem;
      border: 2px solid #E5E7EB;
      border-radius: 12px;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      color: #1F2937;
      background: #FAFAFA;
      transition: all 0.3s ease;
      outline: none;
    }
    .form-group input:focus {
      border-color: #ff4a5a;
      background: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(255, 74, 90, 0.1);
    }
    .form-group input:focus + i,
    .form-group .input-wrapper:focus-within i {
      color: #ff4a5a;
    }
    .form-group input::placeholder {
      color: #9CA3AF;
    }

    /* Submit button */
    .btn-submit {
      width: 100%;
      padding: 0.9rem;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #ff4a5a 0%, #b91c1c 100%);
      color: #FFFFFF;
      font-size: 1rem;
      font-weight: 700;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(255, 74, 90, 0.35);
      margin-top: 1rem;
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 74, 90, 0.5);
    }
    .btn-submit:active {
      transform: translateY(0);
    }

    /* Error alert */
    .alert-danger {
      padding: 0.75rem 1rem;
      border-radius: 12px;
      font-size: 0.875rem;
      font-weight: 600;
      color: #b91c1c;
      background-color: #fef2f2;
      border: 1px solid #fee2e2;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      animation: shake 0.4s ease;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    /* Footer bar */
    .auth-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid #F3F4F6;
    }
    .auth-footer a {
      color: #6B7280;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 600;
      transition: color 0.3s;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .auth-footer a:hover {
      color: #ff4a5a;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .auth-brand { display: none; }
      .auth-container {
        max-width: 420px;
        border-radius: 1.25rem;
      }
      .auth-form-panel {
        padding: 2.5rem 2rem;
      }
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <!-- Left Branding Panel -->
    <div class="auth-brand">
      <img src="/ImgAssets/Logo.png" alt="Calamity Books Logo" onerror="this.src='/imgAssets/Logo.png'">
      <h2>CALAMITY <span>ADMIN</span></h2>
      <p>Management Portal. Authorized access only. Log in to manage orders, products, and system configurations.</p>
    </div>

    <!-- Right Form Panel -->
    <div class="auth-form-panel">
      <h1>Admin Portal</h1>
      <p class="subtitle">Secure login for store management</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-danger">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/staff-login" method="POST">
        <div class="form-group">
          <label for="inputAdminID">Admin ID</label>
          <div class="input-wrapper">
            <input type="text" name="adminID" id="inputAdminID" placeholder="Enter Your Admin ID" required autocomplete="username">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
        </div>

        <div class="form-group">
          <label for="inputPassword">Password</label>
          <div class="input-wrapper">
            <input type="password" name="password" id="inputPassword" placeholder="Enter Your Password" required autocomplete="current-password">
            <i class="fa-solid fa-lock"></i>
          </div>
        </div>

        <button type="submit" class="btn-submit">Login Portal</button>
      </form>

      <div class="auth-footer">
        <a href="/login"><i class="fa-solid fa-arrow-left"></i> Back to log-in</a>
        <span class="text-muted small">v1.2.0</span>
      </div>
    </div>
  </div>
</body>
</html>
