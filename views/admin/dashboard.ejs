<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Calamity Book Store</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
    <style>
        body {
            background-color: #0f0f15;
            color: #e2e8f0;
            font-family: 'Inter', 'Outfit', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .dashboard-container {
            flex: 1;
            padding-bottom: 3rem;
        }

        .stats-card {
            background: linear-gradient(135deg, #1b1b2f 0%, #161626 100%);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .stats-card.revenue::before {
            background-color: #10b981;
        }

        .stats-card.orders::before {
            background-color: #3b82f6;
        }

        .stats-card.products::before {
            background-color: #8b5cf6;
        }

        .stats-card.stock::before {
            background-color: #ef4444;
        }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .stats-icon {
            font-size: 2.25rem;
            opacity: 0.8;
            padding: 10px;
            border-radius: 12px;
        }

        .revenue .stats-icon {
            color: #10b981;
            background: rgba(16, 185, 129, 0.1);
        }

        .orders .stats-icon {
            color: #3b82f6;
            background: rgba(59, 130, 246, 0.1);
        }

        .products .stats-icon {
            color: #8b5cf6;
            background: rgba(139, 92, 246, 0.1);
        }

        .stock .stats-icon {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
        }

        .stats-value {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 2px;
            color: #ffffff;
        }

        .stats-label {
            font-size: 0.875rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .section-box {
            background-color: #161626;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            margin-top: 2rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 10px;
        }

        .section-title i {
            color: #ff4a5a;
        }

        .table-responsive {
            border-radius: 12px;
            overflow: hidden;
        }

        .table {
            background-color: #1b1b2f;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
            color: #e2e8f0;
        }

        .table th {
            background-color: #131322 !important;
            color: #94a3b8;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            padding: 1rem;
            border: none;
        }

        .table td {
            padding: 1rem;
            border-color: rgba(255, 255, 255, 0.03);
            vertical-align: middle;
            background-color: #161626;
        }

        .table tr:hover td {
            background-color: #1d1d35 !important;
        }

        .product-img {
            width: 50px;
            height: 65px;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .badge-sales {
            background-color: rgba(16, 185, 129, 0.15);
            color: #10b981;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }
    </style>
</head>

<body>

    <%- include('../templates/nav-bar-admin', { activeTab: 'dashboard' }) %>

        <div class="container dashboard-container mt-4">
            <div class="row align-items-center mb-4">
                <div class="col-md-6">
                    <h1 style="font-weight: 800; font-size: 2.25rem; letter-spacing: -0.5px; color: #ffffff;">Dashboard
                    </h1>
                    <p class="text-muted mb-0">Overview of the book store metrics and sales analysis.</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <span class="badge bg-secondary px-3 py-2 text-uppercase"
                        style="letter-spacing: 1px; font-weight: 600; background-color: rgba(255,255,255,0.08) !important;">
                        <i class="far fa-calendar-alt me-2"></i> Live Report
                    </span>
                </div>
            </div>

            <!-- KPI Grid -->
            <div class="row g-4">
                <!-- Revenue Card -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stats-card revenue">
                        <div>
                            <div class="stats-value">฿<%= Number(stats.income).toLocaleString(undefined,
                                    {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                            </div>
                            <div class="stats-label">Total Revenue</div>
                        </div>
                        <div class="stats-icon"><i class="fas fa-wallet"></i></div>
                    </div>
                </div>

                <!-- Orders Card -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stats-card orders">
                        <div>
                            <div class="stats-value">
                                <%= stats.orders %>
                            </div>
                            <div class="stats-label">Total Orders</div>
                        </div>
                        <div class="stats-icon"><i class="fas fa-shopping-bag"></i></div>
                    </div>
                </div>

                <!-- Products Card -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stats-card products">
                        <div>
                            <div class="stats-value">
                                <%= stats.products %>
                            </div>
                            <div class="stats-label">Books Catalog</div>
                        </div>
                        <div class="stats-icon"><i class="fas fa-book"></i></div>
                    </div>
                </div>

                <!-- Out of Stock Card -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stats-card stock">
                        <div>
                            <div class="stats-value">
                                <%= stats.outOfStock %>
                            </div>
                            <div class="stats-label">Out of Stock</div>
                        </div>
                        <div class="stats-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    </div>
                </div>
            </div>

            <!-- Best Sellers Section -->
            <div class="section-box">
                <h2 class="section-title"><i class="fas fa-star"></i> Top 5 Best Selling Books</h2>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Rank</th>
                                <th style="width: 100px;">Cover</th>
                                <th>Book Title</th>
                                <th>Category</th>
                                <th class="text-end">Price</th>
                                <th class="text-end" style="width: 150px;">Total Sold</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bestSellers.length===0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No sales data available.</td>
                                </tr>
                                <% } else { %>
                                    <% bestSellers.forEach((book, index)=> { %>
                                        <tr>
                                            <td>
                                                <span class="fw-bold"
                                                    style="font-size: 1.1rem; color: <%= index === 0 ? '#fbbf24' : index === 1 ? '#94a3b8' : index === 2 ? '#b45309' : '#64748b' %>;">
                                                    #<%= index + 1 %>
                                                </span>
                                            </td>
                                            <td>
                                                <img src="<%= book.img_link || book.img_url || 'https://picsum.photos/seed/placeholder/200/300' %>"
                                                    alt="<%= book.product_name %>" class="product-img">
                                            </td>
                                            <td>
                                                <div class="fw-bold text-white">
                                                    <%= book.product_name %>
                                                </div>
                                                <span class="text-muted" style="font-size: 0.8rem;">ID: <%=
                                                        book.product_id %></span>
                                            </td>
                                            <td>
                                                <span class="badge bg-dark text-white border border-secondary"
                                                    style="font-weight: 500; font-size: 0.8rem;">
                                                    <%= book.category_type %>
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-light">฿<%=
                                                    Number(book.price).toLocaleString(undefined, {minimumFractionDigits:
                                                    2}) %>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge-sales">
                                                    <%= book.saleCount %> sold
                                                </span>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%- include('../templates/footer-admin') %>

</body>

</html>