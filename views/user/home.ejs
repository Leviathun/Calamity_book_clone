<%- include('../templates/nav-bot') %>

<!-- Hero Carousel -->
<div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
  </div>
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="https://picsum.photos/1200/400?random=1" class="d-block w-100" alt="Promotion Banner">
    </div>
    <div class="carousel-item">
      <img src="https://picsum.photos/1200/400?random=2" class="d-block w-100" alt="Best Deals Banner">
    </div>
    <div class="carousel-item">
      <img src="https://picsum.photos/1200/400?random=3" class="d-block w-100" alt="New Arrivals Banner">
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>

<!-- ======================= PROMOTION SECTION ======================= -->
<section class="containers wraper" id="Flash sale">

  <div class="bannerTopic">
    <div class="d-flex flex-column flex-lg-row center">
      <h2 class="filterflashsale-title">
        <i class="fa-solid fa-tag"></i>
        Promotion
      </h2>

      <div>
        <div id="counter" class="counter">
          <ul class="countdown">
            <li class="first" style="display: none;">
              <div class="countdown_num" id="cd_day-82520" style="display: none;"></div><div id="cd_day"></div>
            </li>
            <li>
              <div class="countdown_num" id="cd_hour-82520">07</div><div id="cd_hour">Hours</div>
            </li>
            <li>
              <div class="countdown_num" id="cd_min-82520">38</div><div id="cd_minute">Minutes</div>
            </li>
            <li class="last">
              <div class="countdown_num" id="cd_sec-82520">02</div><div id="cd_second">Seconds</div>
            </li>
          </ul>
          <div class="clear"><span>&nbsp;</span></div>
        </div>
        <div id="expired" style="display:none;">The deadline has passed.</div>
      </div>
    </div>
    
    <div class="btnViewall">
      <a href="/all-books?tag=Promotion">View all <i class="fas fa-chevron-right fa-xs"></i></a>
    </div>
  </div>

  <div class="row">
    <!-- Flash banner -->
    <div class="col-12 col-lg-3">
      <div id="banner-slider-one">
        <a href="#"> 
          <img class="img-responsive" src="https://www.asiabooks.com/media/mageplaza/bannerslider/banner/image/f/l/flashsale_01092023.jpg" alt="Flash Sale">
        </a>
      </div>
    </div>
    
    <div class="col-12 col-lg-9">
      <div class="products-con">
        <% const filteredProducts = products.filter(product => product.secondary_category === 'Promotion').slice(0, 4);
        if (filteredProducts.length === 0) { %>
          <p>No products available</p>
        <% } else { %>
          <% filteredProducts.forEach(product => { %>
            <div class="products-item" onclick="window.location.href='/product-page?id=<%= product.product_id %>'">
              <div class="products-img position-relative">
                <a href="/product-page?id=<%= product.product_id %>" onclick="event.stopPropagation();">
                  <img src="<%= product.img_url %>" alt="<%= product.product_name %>">
                </a>
                <p class="product-label position-absolute">
                  <span class="line-1"><%= product.percent %>%</span>
                  <br>
                  <span class="line-2">OFF</span>
                </p>
              </div>
              <div class="products-detail">
                <p><span><%= product.product_name %></span></p>
                <p><%= product.category_type %></p>
              </div>
              <div class="products-price">
                <div class="discount">
                  <p><i class="fa-solid fa-baht-sign"></i><%= product.price_discount %></p>
                </div>
                <div class="original">
                  <p><span class="line-discount"><i class="fa-solid fa-baht-sign"></i><%= product.price %></span></p>
                </div>
              </div>
              <div class="products-buy">
                <div>
                  <button class="addbag-b" onclick="event.stopPropagation(); addToCart(<%= product.product_id %>)"><p>Add to cart</p></button>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>             
    </div>
  </div>
</section>

