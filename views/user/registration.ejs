<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up — Calamity Books</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/451145afdd.js" crossorigin="anonymous"></script>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0A7C6E 0%, #064E45 50%, #0A7C6E 100%);
      padding: 20px;
      position: relative;
      overflow: hidden;
    }
    /* Rich background with mesh gradient overlay */
    body::before {
      content: '';
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(ellipse 800px 600px at 10% 90%, rgba(245, 158, 11, 0.3) 0%, transparent 70%),
        radial-gradient(ellipse 800px 600px at 90% 10%, rgba(255, 107, 53, 0.5) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    body::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 L35 25 L55 30 L35 35 L30 55 L25 35 L5 30 L25 25Z' fill='rgba(255,255,255,0.08)'/%3E%3C/svg%3E");
      background-size: 100px 100px;
      pointer-events: none;
      animation: bgShift 13s linear infinite;
      z-index: 0;
    }
    @keyframes bgShift {
      0% { background-position: 0 0; }
      100% { background-position: 100px 100px; }
    }

    .auth-container {
      display: flex;
      width: 100%;
      max-width: 900px;
      min-height: 620px;
      background: #FFFFFF;
      border-radius: 1.5rem;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,0.3);
      position: relative;
      z-index: 1;
    }

    /* Left panel */
    .auth-brand {
      flex: 1;
      background: linear-gradient(160deg, #0A7C6E 0%, #064E45 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .auth-brand img {
      width: 260px;
      margin-bottom: 2rem;
      filter: drop-shadow(0 0 1px #000) drop-shadow(0 0 1px #000)
             drop-shadow(0 0 15px rgba(255, 255, 255, 0.7)) drop-shadow(0 0 35px rgba(255, 255, 255, 0.4))
             drop-shadow(0 0 60px rgba(255, 255, 255, 0.2));
      position: relative;
      z-index: 1;
    }
    .auth-brand h2 {
      color: #FFFFFF;
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
      position: relative; z-index: 1;
    }
    .auth-brand p {
      color: rgba(255,255,255,0.75);
      font-size: 0.95rem;
      line-height: 1.6;
      max-width: 260px;
      position: relative; z-index: 1;
    }

    /* Right panel */
    .auth-form-panel {
      flex: 1.1;
      padding: 2.5rem 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .auth-form-panel h1 {
      font-size: 2rem;
      font-weight: 800;
      color: #1F2937;
      margin-bottom: 0.25rem;
    }
    .auth-form-panel .subtitle {
      color: #6B7280;
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    /* Tab buttons */
    .auth-tabs {
      display: flex;
      gap: 0;
      margin-bottom: 1.5rem;
      background: #F3F4F6;
      border-radius: 12px;
      padding: 4px;
    }
    .auth-tabs a {
      flex: 1;
      text-align: center;
      padding: 0.7rem 1rem;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      border-radius: 10px;
      transition: all 0.3s ease;
      color: #6B7280;
    }
    .auth-tabs a.active {
      background: #0A7C6E;
      color: #FFFFFF;
      box-shadow: 0 2px 8px rgba(10, 124, 110, 0.3);
    }
    .auth-tabs a:not(.active):hover {
      color: #0A7C6E;
    }

    /* Form fields */
    .form-group {
      margin-bottom: 1rem;
    }
    .form-group label {
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      color: #374151;
      margin-bottom: 0.35rem;
    }
    .form-group .input-wrapper {
      position: relative;
    }
    .form-group .input-wrapper i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #9CA3AF;
      font-size: 0.95rem;
      transition: color 0.3s;
    }
    .form-group input {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.8rem;
      border: 2px solid #E5E7EB;
      border-radius: 12px;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      color: #1F2937;
      background: #FAFAFA;
      transition: all 0.3s ease;
      outline: none;
    }
    .form-group input:focus {
      border-color: #0A7C6E;
      background: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(10, 124, 110, 0.1);
    }
    .form-group .input-wrapper:focus-within i {
      color: #0A7C6E;
    }
    .form-group input::placeholder {
      color: #9CA3AF;
    }

    /* Submit button */
    .btn-submit {
      width: 100%;
      padding: 0.85rem;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #F59E0B 0%, #FF6B35 100%);
      color: #FFFFFF;
      font-size: 1rem;
      font-weight: 700;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.35);
      margin-top: 0.5rem;
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
    }
    .btn-submit:active {
      transform: translateY(0);
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 1.25rem 0;
    }
    .divider hr {
      flex: 1;
      border: none;
      border-top: 1px solid #E5E7EB;
    }
    .divider span {
      color: #9CA3AF;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Social buttons */
    .social-btns {
      display: flex;
      gap: 1rem;
    }
    .social-btns a {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.65rem 1rem;
      border: 2px solid #E5E7EB;
      border-radius: 12px;
      text-decoration: none;
      color: #374151;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.3s ease;
      background: #FFFFFF;
    }
    .social-btns a:hover {
      border-color: #0A7C6E;
      background: #F0FDF9;
      transform: translateY(-1px);
    }
    .social-btns a img {
      width: 20px;
      height: 20px;
    }

    /* Footer bar */
    .auth-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #F3F4F6;
    }
    .auth-footer a {
      color: #6B7280;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 600;
      transition: color 0.3s;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .auth-footer a:hover {
      color: #0A7C6E;
    }
    .auth-footer .admin-link:hover {
      color: #F59E0B;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .auth-brand { display: none; }
      .auth-container {
        max-width: 420px;
        border-radius: 1.25rem;
      }
      .auth-form-panel {
        padding: 2rem 1.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <!-- Left Branding Panel -->
    <div class="auth-brand">
      <img src="/imgAssets/Logo.png" alt="Calamity Books Logo">
      <h2>Join Us!</h2>
      <p>Create your account and start building your personal bookshelf today.</p>
    </div>

    <!-- Right Form Panel -->
    <div class="auth-form-panel">
      <h1>Sign Up</h1>
      <p class="subtitle">Create your free account</p>

      <div class="auth-tabs">
        <a href="/login">Log In</a>
        <a href="/registration" class="active">Sign Up</a>
      </div>

      <form action="/register" method="POST">
        <div class="form-group">
          <label for="inputName">Name</label>
          <div class="input-wrapper">
            <input type="text" name="name" id="inputName" placeholder="Your full name" required>
            <i class="fa-solid fa-user"></i>
          </div>
        </div>

        <div class="form-group">
          <label for="inputEmail">Email</label>
          <div class="input-wrapper">
            <input type="email" name="email" id="inputEmail" placeholder="you@example.com" required>
            <i class="fa-solid fa-envelope"></i>
          </div>
        </div>

        <div class="form-group">
          <label for="inputPassword">Password</label>
          <div class="input-wrapper">
            <input type="password" name="password" id="inputPassword" placeholder="Create a password" required>
            <i class="fa-solid fa-lock"></i>
          </div>
        </div>

        <div class="form-group">
          <label for="inputConfirmPassword">Confirm Password</label>
          <div class="input-wrapper">
            <input type="password" name="confirmPassword" id="inputConfirmPassword" placeholder="Confirm your password" required>
            <i class="fa-solid fa-shield-halved"></i>
          </div>
        </div>

        <button type="submit" class="btn-submit">Create Account</button>
      </form>

      <div class="divider">
        <hr><span>or</span><hr>
      </div>

      <div class="social-btns">
        <a href="https://www.google.co.uk/" target="_blank">
          <img src="/imgAssets/googleLogo.svg" alt="Google">
          Google
        </a>
        <a href="https://www.facebook.com/" target="_blank">
          <img src="/imgAssets/facebookLogo.svg" alt="Facebook">
          Facebook
        </a>
      </div>

      <div class="auth-footer">
        <a href="/home"><i class="fa-solid fa-arrow-left"></i> Back to shop</a>
        <a href="/staff-login" class="admin-link"><i class="fa-solid fa-shield-halved"></i> Admin</a>
      </div>
    </div>
  </div>
</body>
</html>
