<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <script
      src="https://kit.fontawesome.com/451145afdd.js"
      crossorigin="anonymous"
    ></script>

    
    <link rel="stylesheet" href="css/Home.css">
    <link rel="stylesheet" href="css/Cart-page.css">

</head>
  <body>

    <%- include('../templates/nav-bar-user') %>

    <!--Shopping cart container start-->
    <!--Shopping cart start-->
    <div class="containers wraper" style="margin-top: 50px; margin-bottom: 50px;">
    
        <div class="d-flex">
            <div class="contentleft">
                <div class="bannerTopic">
                    <div class="d-flex flex-column flex-lg-row center">
                        <h2 class="filterflashsale-title minih2">
                            Shopping Cart
                        </h2>                
                    </div>
            
                    <div class="updateCart center">
                        <button>update shopping cart</button>
                    </div>
  
                </div>

                <% if (cartItems && cartItems.length > 0) { %>
                    <% cartItems.forEach(item => { %>
                        <!--Product cart start-->
                        <div class="row active" id="cart-item-<%= item.cart_id %>">
                            <div class="d-flex borderCart" >
                                <div>
                                    <img src="<%= item.img_link %>" alt="<%= item.product_name %>" id="miniImg" width="200px" style="object-fit: cover;">
                                </div>
                                <div class="morespace center">
                                    <div>
                                        <h3 class="mini"><%= item.product_name %></h3>
                                        <br>
                                        <h3 class="mini">item #<%= item.product_id %></h3>
                                    </div>
                                    <div class="add">
                                        <button class="addremove-btn" onclick="addToWishlist(<%= item.product_id %>)"><p><i class="fa-solid fa-heart"></i> add to wishlist</p></button>
                                    </div>
                                </div>
                                <div class="morespace center">
                                    <div>
                                        <h3 class="mini">Price : <%= item.price_discount || item.price %> THB </h3>
                                        <br>
                                        <input class="mini qty-input" type="number" value="<%= item.quantity %>" min="1" onchange="updateCartItem(<%= item.cart_id %>, this.value)">
                                    </div>
                                    <div class="remove">
                                        <button class="addremove-btn" onclick="removeCartItem(<%= item.cart_id %>)"><p><i class="fa-solid fa-trash"></i> remove</p></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--Shopping cart end-->
                    <% }); %>
                <% } else { %>
                    <div class="row active">
                        <div class="d-flex borderCart center p-5">
                            <h3 class="mini">Your cart is empty. <a href="/home">Go Shopping!</a></h3>
                        </div>
                    </div>
                <% } %>

            </div>

            <!--Order summary statr-->
            <div class="contentright">
                <div class="row borderOrder">
                    <div>
                        <h1 class="center minih1">Order summary</h1>
                    </div>
                    <div class="center">
                        <h2 class="mini">Subtotal THB : <span> <%= subtotal %> </span></h2>
                    </div>
                    <div class="center">
                        <h2 class="mini">Payment : <span> ? </span></h2>
                    </div>
                    <div class="center">
                        <button id="Checkout" method="" action="">Checkout</button>
                    </div>
                    
                </div>
            </div>
            <!--Order summary end-->
     
        </div>
    </div>
    
    <!--Shopping cart container end-->
           
    <%- include('../templates/user-footer') %>
 
 <script src="js/home.js"></script>
    
      <script
        src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"
      ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
      integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
      crossorigin="anonymous"
    ></script>
    
    <script>
        async function removeCartItem(cartId) {
            if(!confirm('Remove this item from your cart?')) return;
            try {
                const res = await fetch('/cart/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cart_id: cartId })
                });
                const data = await res.json();
                if(data.success) {
                    location.reload(); // reload page to update subtotal and items
                } else {
                    alert(data.message || 'Error removing item');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function updateCartItem(cartId, quantity) {
            if(quantity < 1) return removeCartItem(cartId);
            try {
                const res = await fetch('/cart/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cart_id: cartId, quantity: quantity })
                });
                const data = await res.json();
                if(data.success) {
                    location.reload(); // reload page to update subtotal
                } else {
                    alert(data.message || 'Error updating item');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function addToWishlist(productId) {
            try {
                const response = await fetch('/wishlist/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ product_id: productId })
                });
                const result = await response.json();
                if (response.status === 401) {
                    alert(result.message);
                    window.location.href = '/login';
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error(error);
                alert('An error occurred. Please try again.');
            }
        }
    </script>
  </body>
  
</html>
