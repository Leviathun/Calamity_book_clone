<div class="containers wraper">

  <!-- Cart Page Grid -->
  <div class="cart-page">

    <!-- Left: Cart Items -->
    <div class="cart-left">

      <!-- Cart Header -->
      <div class="cart-header">
        <div class="cart-header-left">
          <div class="cart-icon-box">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
          <h1>Shopping Cart</h1>
          <% if (cartItems && cartItems.length > 0) { %>
            <span class="item-count">(<%= cartItems.length %> items)</span>
          <% } %>
        </div>
      </div>

      <!-- Cart Items -->
      <% if (cartItems && cartItems.length > 0) { %>
        <div class="cart-items-list">
          <% cartItems.forEach(item => { %>
            <div class="cart-item-card" id="cart-item-<%= item.cart_id %>">

              <!-- Image -->
              <div class="cart-item-img">
                <a href="/product-page?id=<%= item.product_id %>">
                  <img src="<%= item.img_link %>" alt="<%= item.product_name %>">
                </a>
              </div>

              <!-- Details -->
              <div class="cart-item-details">
                <a href="/product-page?id=<%= item.product_id %>" style="text-decoration:none;">
                  <h3 class="item-name"><%= item.product_name %></h3>
                </a>
                <span class="item-id">Item #<%= item.product_id %></span>
                <span class="item-price">
                  <i class="fa-solid fa-baht-sign"></i><%= item.price_discount || item.price %>
                </span>
              </div>

              <!-- Actions -->
              <div class="cart-item-actions">
                <!-- Quantity -->
                <div class="cart-qty-selector">
                  <button type="button" class="cart-qty-btn" onclick="cartChangeQty(<%= item.cart_id %>, -1, this)">−</button>
                  <input type="number" class="cart-qty-input" value="<%= item.quantity %>" min="1"
                         onchange="updateCartItem(<%= item.cart_id %>, this.value)">
                  <button type="button" class="cart-qty-btn" onclick="cartChangeQty(<%= item.cart_id %>, 1, this)">+</button>
                </div>

                <!-- Mini action buttons -->
                <div class="cart-action-btns">
                  <button class="btn-cart-wishlist" onclick="addToWishlist(<%= item.product_id %>)">
                    <i class="fa-solid fa-heart"></i> Wishlist
                  </button>
                  <button class="btn-cart-remove" onclick="removeCartItem(<%= item.cart_id %>)">
                    <i class="fa-solid fa-trash"></i> Remove
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="cart-empty">
          <i class="fa-solid fa-cart-shopping"></i>
          <h3>Your cart is empty</h3>
          <p>Looks like you haven't added any books yet.</p>
          <a href="/home"><i class="fa-solid fa-arrow-left"></i> Start Shopping</a>
        </div>
      <% } %>
    </div>

    <!-- Right: Order Summary -->
    <div class="order-summary">
      <h2>Order Summary</h2>

      <div class="summary-row">
        <span class="label">Subtotal (<%= cartItems ? cartItems.length : 0 %> items)</span>
        <span class="value"><i class="fa-solid fa-baht-sign"></i><%= subtotal %></span>
      </div>

      <div class="summary-row">
        <span class="label">Shipping</span>
        <span class="value" style="color: #10B981; font-size: 0.85rem;">Free</span>
      </div>

      <hr class="summary-divider">

      <div class="summary-total">
        <span class="label">Total</span>
        <span class="value"><i class="fa-solid fa-baht-sign"></i><%= subtotal %></span>
      </div>

      <button class="btn-checkout" type="button">
        <i class="fa-solid fa-lock"></i>
        Proceed to Checkout
      </button>

      <a href="/home" class="btn-continue-shopping">
        <i class="fa-solid fa-arrow-left"></i>
        Continue Shopping
      </a>

      <div class="summary-footer">
        <i class="fa-solid fa-shield-halved"></i>
        Secure checkout guaranteed
      </div>
    </div>
  </div>
</div>

<script>
// Quantity +/- for cart items
function cartChangeQty(cartId, delta, btn) {
  const selector = btn.closest('.cart-qty-selector');
  const input = selector.querySelector('.cart-qty-input');
  let val = parseInt(input.value) || 1;
  val = Math.max(1, val + delta);
  input.value = val;
  updateCartItem(cartId, val);
}

// Remove item
async function removeCartItem(cartId) {
  if (!confirm('Remove this item from your cart?')) return;
  try {
    const res = await fetch('/cart/remove', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cart_id: cartId })
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Error removing item');
    }
  } catch (e) {
    console.error(e);
  }
}

// Update quantity
async function updateCartItem(cartId, quantity) {
  if (quantity < 1) return removeCartItem(cartId);
  try {
    const res = await fetch('/cart/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cart_id: cartId, quantity: quantity })
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Error updating item');
    }
  } catch (e) {
    console.error(e);
  }
}

// Add to wishlist
async function addToWishlist(productId) {
  try {
    const response = await fetch('/wishlist/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ product_id: productId })
    });
    const result = await response.json();
    if (response.status === 401) {
      alert(result.message);
      window.location.href = '/login';
    } else {
      alert(result.message);
    }
  } catch (error) {
    console.error(error);
    alert('An error occurred. Please try again.');
  }
}
</script>
