<div class="containers wraper">

  <!-- Page Header -->
  <div class="myorder-header">
    <div class="header-icon">
      <i class="fa-solid fa-bag-shopping"></i>
    </div>
    <h1>My Orders</h1>
  </div>

  <!-- Tabs Navigation -->
  <ul class="nav mb-4 custom-tabs" id="myOrderTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active fw-bold px-4 py-3" id="recent-tab" data-bs-toggle="tab" data-bs-target="#recent-pane" type="button" role="tab" aria-controls="recent-pane" aria-selected="true">
        <i class="fa-solid fa-chart-line me-2"></i>Recent Orders
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-bold px-4 py-3" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist-pane" type="button" role="tab" aria-controls="wishlist-pane" aria-selected="false">
        <i class="fa-solid fa-heart me-2"></i>My Wishlist
        <% if (wishlistItems && wishlistItems.length > 0) { %>
          <span class="badge rounded-pill ms-2" style="background: rgba(10,124,110,0.1); color: #0A7C6E;"><%= wishlistItems.length %></span>
        <% } %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-bold px-4 py-3" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab" aria-controls="history-pane" aria-selected="false">
        <i class="fa-solid fa-clock-rotate-left me-2"></i>Order History
        <% if (allOrders && allOrders.length > 0) { %>
          <span class="badge rounded-pill ms-2" style="background: rgba(10,124,110,0.1); color: #0A7C6E;"><%= allOrders.length %></span>
        <% } %>
      </button>
    </li>
  </ul>

  <!-- Tabs Content -->
  <div class="tab-content" id="myOrderTabsContent">
    
    <!-- =============== SECTION 1: ORDER STATUS (5 Latest) =============== -->
    <div class="tab-pane fade show active mt-3" id="recent-pane" role="tabpanel" aria-labelledby="recent-tab" tabindex="0">

  <% if (recentOrders && recentOrders.length > 0) { %>
    <div class="status-cards">
      <% recentOrders.forEach(order => { %>
        <div class="status-card" onclick="window.location.href='/order-details?id=<%= order.order_id %>'" style="cursor: pointer;">
          <div class="sc-img">
            <img src="<%= order.img_link || 'https://picsum.photos/seed/bk1/200/300' %>" alt="<%= order.product_name || 'Book' %>">
          </div>
          <div class="sc-info">
            <div class="sc-name"><%= order.product_name || ('Order #' + order.order_id) %></div>
            <div class="sc-date"><%= new Date(order.order_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
          </div>
          <div class="sc-price">
            <i class="fa-solid fa-baht-sign"></i><%= order.total_price %>
          </div>
          <% 
            let statusClass = 'status-pending';
            let statusIcon = 'fa-clock';
            const st = order.status;
            if (st === 'Paid') { statusClass = 'status-paid'; statusIcon = 'fa-circle-check'; }
            else if (st === 'Pending') { statusClass = 'status-pending'; statusIcon = 'fa-clock'; }
            else if (st === 'Shipping') { statusClass = 'status-shipping'; statusIcon = 'fa-truck'; }
            else if (st === 'Delivered') { statusClass = 'status-delivered'; statusIcon = 'fa-box-open'; }
            else if (st === 'Returned') { statusClass = 'status-returned'; statusIcon = 'fa-rotate-left'; }
          %>
          <span class="status-badge <%= statusClass %>">
            <i class="fa-solid <%= statusIcon %>"></i> <%= order.status %>
          </span>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="section-empty">
      <i class="fa-solid fa-bag-shopping"></i>
      <p>No orders yet. Start shopping!</p>
    </div>
  <% } %>

    </div> <!-- End Tab 1 -->

    <!-- =============== SECTION 2: WISHLIST =============== -->
    <div class="tab-pane fade mt-3" id="wishlist-pane" role="tabpanel" aria-labelledby="wishlist-tab" tabindex="0">

  <% if (wishlistItems && wishlistItems.length > 0) { %>
    <div class="wishlist-grid">
      <% wishlistItems.forEach(item => { %>
        <div class="wishlist-card" id="wl-<%= item.wishlist_id %>">
          <div class="wl-img">
            <a href="/product-page?id=<%= item.product_id %>">
              <img src="<%= item.img_link %>" alt="<%= item.product_name %>">
            </a>
          </div>
          <div class="wl-info">
            <div class="wl-name"><%= item.product_name %></div>
            <div class="wl-price"><i class="fa-solid fa-baht-sign"></i><%= item.price_discount || item.price %></div>
          </div>
          <div class="wl-actions">
            <button class="wl-btn-cart" onclick="wlAddToCart(<%= item.product_id %>)">
              <i class="fa-solid fa-cart-plus"></i> Cart
            </button>
            <button class="wl-btn-remove" onclick="wlRemove(<%= item.wishlist_id %>)">
              <i class="fa-solid fa-trash"></i> Remove
            </button>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="section-empty">
      <i class="fa-solid fa-heart"></i>
      <p>Your wishlist is empty.</p>
    </div>
  <% } %>

    </div> <!-- End Tab 2 -->

    <!-- =============== SECTION 3: ORDER HISTORY =============== -->
    <div class="tab-pane fade mt-3" id="history-pane" role="tabpanel" aria-labelledby="history-tab" tabindex="0">

  <% if (allOrders && allOrders.length > 0) { %>
    <div class="history-table-wrap">
      <table class="history-table">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Date</th>
            <th>Items</th>
            <th>Total</th>
            <th>Payment</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% allOrders.forEach(order => { %>
            <tr onclick="window.location.href='/order-details?id=<%= order.order_id %>'" style="cursor: pointer;">
              <td class="ht-order-id">#<%= order.order_id %></td>
              <td><%= new Date(order.order_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              <td><%= order.item_count %> book<%= order.item_count > 1 ? 's' : '' %></td>
              <td><i class="fa-solid fa-baht-sign"></i><%= order.total_price %></td>
              <td><%= order.payment_method === 'cod' ? 'COD' : 'Credit Card' %></td>
              <td>
                <% 
                  let hClass = 'status-pending';
                  let hIcon = 'fa-clock';
                  const hs = order.status;
                  if (hs === 'Paid') { hClass = 'status-paid'; hIcon = 'fa-circle-check'; }
                  else if (hs === 'Pending') { hClass = 'status-pending'; hIcon = 'fa-clock'; }
                  else if (hs === 'Shipping') { hClass = 'status-shipping'; hIcon = 'fa-truck'; }
                  else if (hs === 'Delivered') { hClass = 'status-delivered'; hIcon = 'fa-box-open'; }
                  else if (hs === 'Returned') { hClass = 'status-returned'; hIcon = 'fa-rotate-left'; }
                %>
                <span class="status-badge <%= hClass %>">
                  <i class="fa-solid <%= hIcon %>"></i> <%= order.status %>
                </span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="section-empty">
      <i class="fa-solid fa-clock-rotate-left"></i>
      <p>No order history yet.</p>
    </div>
  <% } %>

    </div> <!-- End Tab 3 -->
  </div> <!-- End Tab Content -->

</div>

<style>
  /* Custom Tab Styling */
  .custom-tabs {
    gap: 0;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    border-bottom: none;
    padding: 0;
  }
  .custom-tabs .nav-item {
    flex: 1;
    text-align: center;
  }
  .custom-tabs .nav-link {
    color: #6B7280;
    border: none;
    border-bottom: 2px solid #E5E7EB; /* gray line on every tab */
    background: transparent;
    border-radius: 0;
    transition: all 0.2s ease;
    white-space: nowrap;
    width: 100%;
    padding: 0.75rem 1.5rem;
  }
  .custom-tabs .nav-link:hover {
    color: #1F2937;
    border-bottom-color: #9CA3AF;
  }
  .custom-tabs .nav-link.active {
    color: #0A7C6E !important;
    border-bottom-color: #0A7C6E !important;
  }
</style>

<script>
// Wishlist: Add to cart
async function wlAddToCart(productId) {
  try {
    const res = await fetch('/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ product_id: productId, quantity: 1 })
    });
    const data = await res.json();
    if (res.status === 401) {
      alert(data.message);
      window.location.href = '/login';
    } else {
      alert(data.message);
    }
  } catch (e) {
    console.error(e);
    alert('Error adding to cart');
  }
}

// Wishlist: Remove
async function wlRemove(wishlistId) {
  if (!confirm('Remove from wishlist?')) return;
  try {
    const res = await fetch('/wishlist/remove', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ wishlist_id: wishlistId })
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Error removing item');
    }
  } catch (e) {
    console.error(e);
  }
}
</script>
