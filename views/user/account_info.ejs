<div class="containers wraper">
  <div class="account-page">

    <!-- Main Content -->
    <div class="account-content">

      <!-- Header -->
      <div class="account-header">
        <div class="header-icon">
          <i class="fa-solid fa-user-gear"></i>
        </div>
        <h1>Account Information</h1>
      </div>

      <!-- User Info List -->
      <div class="info-list-card">
        <div class="info-row">
          <div class="info-row-label"><i class="fa-solid fa-user"></i> Full Name</div>
          <div class="info-row-value"><%= locals.user ? user.name : 'Not available' %></div>
        </div>
        <div class="info-row">
          <div class="info-row-label"><i class="fa-solid fa-envelope"></i> Email</div>
          <div class="info-row-value"><%= locals.user ? user.email : 'Not available' %></div>
        </div>
        <div class="info-row">
          <div class="info-row-label"><i class="fa-solid fa-phone"></i> Phone</div>
          <div class="info-row-value"><%= (locals.user && user.phone) ? user.phone : 'Not set' %></div>
        </div>
        <div class="info-row">
          <div class="info-row-label"><i class="fa-solid fa-calendar-days"></i> Member Since</div>
          <div class="info-row-value"><%= (locals.user && user.created_at) ? new Date(user.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'N/A' %></div>
        </div>
      </div>

      <!-- Address Section -->
      <div class="account-section-header">
        <div class="header-icon">
          <i class="fa-solid fa-location-dot"></i>
        </div>
        <h2>Address</h2>
      </div>

      <% if (locals.address && address) { %>
        <div class="info-list-card">
          <div class="info-row">
            <div class="info-row-label"><i class="fa-solid fa-house"></i> Address</div>
            <div class="info-row-value"><%= address.address_line %></div>
          </div>
          <div class="info-row">
            <div class="info-row-label"><i class="fa-solid fa-city"></i> City</div>
            <div class="info-row-value"><%= address.city %></div>
          </div>
          <div class="info-row">
            <div class="info-row-label"><i class="fa-solid fa-map-pin"></i> Zip Code</div>
            <div class="info-row-value"><%= address.zip_code %></div>
          </div>
        </div>
      <% } else { %>
        <div class="info-empty">
          <i class="fa-solid fa-location-dot"></i>
          <p>No address saved yet. Add one below.</p>
        </div>
      <% } %>

      <!-- Edit Profile / Address Section -->
      <div class="account-section-header" id="edit-section">
        <div class="header-icon">
          <i class="fa-solid fa-pen-to-square"></i>
        </div>
        <h2>Edit Profile</h2>
      </div>

      <div class="edit-form-card">
        <form id="editProfileForm">
          <div class="edit-form-group">
            <label for="editName"><i class="fa-solid fa-user"></i> Name</label>
            <input type="text" id="editName" name="name" value="<%= locals.user ? user.name : '' %>" placeholder="Your full name">
          </div>
          <div class="edit-form-group">
            <label for="editPhone"><i class="fa-solid fa-phone"></i> Phone</label>
            <input type="text" id="editPhone" name="phone" value="<%= (locals.user && user.phone) ? user.phone : '' %>" placeholder="Phone number">
          </div>

          <div class="edit-form-divider"></div>
          <h4 class="edit-form-subtitle"><i class="fa-solid fa-location-dot"></i> Address</h4>

          <div class="edit-form-group">
            <label for="editAddress">Address Line</label>
            <input type="text" id="editAddress" name="address_line" value="<%= (locals.address && address) ? address.address_line : '' %>" placeholder="House/Building No, Street, etc.">
          </div>
          <div class="edit-form-row">
            <div class="edit-form-group">
              <label for="editCity">City</label>
              <input type="text" id="editCity" name="city" value="<%= (locals.address && address) ? address.city : '' %>" placeholder="City or town">
            </div>
            <div class="edit-form-group">
              <label for="editZip">Zip Code</label>
              <input type="text" id="editZip" name="zip_code" value="<%= (locals.address && address) ? address.zip_code : '' %>" placeholder="Zip/Postal code">
            </div>
          </div>

          <button type="submit" class="btn-save-profile">
            <i class="fa-solid fa-floppy-disk"></i> Save Changes
          </button>
        </form>
      </div>

    </div>

    <!-- Sidebar (right) -->
    <aside class="account-sidebar">
      <div class="sidebar-profile">
        <div class="sidebar-avatar">
          <i class="fa-solid fa-user"></i>
        </div>
        <% if (locals.user) { %>
          <p class="profile-name"><%= user.name %></p>
          <p class="profile-email"><%= user.email %></p>
        <% } else { %>
          <p class="profile-name">Guest</p>
          <p class="profile-email">Not logged in</p>
        <% } %>
      </div>

      <div class="sidebar-actions">
        <a href="#edit-section" class="sidebar-btn sidebar-btn-edit" onclick="document.getElementById('edit-section').scrollIntoView({behavior:'smooth'})">
          <i class="fa-solid fa-pen-to-square"></i> Edit Profile
        </a>
        <a href="/sign-out" class="sidebar-btn sidebar-btn-signout">
          <i class="fa-solid fa-right-from-bracket"></i> Sign Out
        </a>
      </div>
    </aside>

  </div>
</div>

<script>
document.getElementById('editProfileForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const formData = {
    name: document.getElementById('editName').value,
    phone: document.getElementById('editPhone').value,
    address_line: document.getElementById('editAddress').value,
    city: document.getElementById('editCity').value,
    zip_code: document.getElementById('editZip').value
  };

  try {
    const res = await fetch('/account-info/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    });
    const data = await res.json();
    if (data.success) {
      alert('Profile updated successfully!');
      location.reload();
    } else {
      alert(data.message || 'Error updating profile');
    }
  } catch (err) {
    console.error(err);
    alert('An error occurred. Please try again.');
  }
});
</script>
